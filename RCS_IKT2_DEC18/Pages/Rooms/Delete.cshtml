@page
@model RCS_IKT2_DEC18.Pages.RoomPages.DeleteModel

@{
    ViewData["Title"] = "Szoba törlése";
}

<h1>Törlés</h1>

<h3>Biztosan törölni akarja ezt a szobát?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.Number)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Number)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.Floor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Floor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.RoomType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.RoomType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.RoomType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.RoomType)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Room.Id" />

        @if(Model.Room.Bookings.Count() > 0){
            <p class="text-danger">A szoba nem törölhető, mert van hozzá tartozó foglalás!</p>
        }

        <input type="submit" value="Törlés" class="btn btn-danger" disabled="@(Model.Room.Bookings.Count() > 0)" /> |
        <a asp-page="./Index">Vissza a listához</a>
    </form>
</div>
