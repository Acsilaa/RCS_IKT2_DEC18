@page
@model RCS_IKT2_DEC18.Pages.RoomPages.DetailsModel

@{
    ViewData["Title"] = "Szoba részletei";
}

<h1>Részletek</h1>

<div>
    <h4>Szoba</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.Number)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Number)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.Floor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.Floor)
        </dd>

        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.IsActive)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.IsActive)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Room.RoomType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Room.RoomType)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Room.Id">Szerkesztés</a> |
    <a asp-page="./Index">Vissza a listához</a>
