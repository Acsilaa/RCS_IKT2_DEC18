@page
@model RCS_IKT2_DEC18.Pages.RoomPages.IndexModel

@{
    ViewData["Title"] = "Szobák";
}

<h1>Szobák</h1>

<p>
    <a asp-page="Create">+ Új</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].Floor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].RoomType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Room[0].IsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Room) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Number)
            </td>
            <td>
                @Html.DisplayFor(model => item.Floor)
            </td>
            <td>
                @item.RoomType
            </td>
            <td>
                @Html.DisplayFor(model => item.IsActive)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerk</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Több</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
