@page
@model RCS_IKT2_DEC18.Pages.RoomPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Room</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Room.Number" class="control-label"></label>
                <input asp-for="Room.Number" class="form-control" />
                <span asp-validation-for="Room.Number" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.Floor" class="control-label"></label>
                <input asp-for="Room.Floor" class="form-control" />
                <span asp-validation-for="Room.Floor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.RoomTypeId" class="control-label"></label>
                <input asp-for="Room.RoomTypeId" class="form-control" />
                <span asp-validation-for="Room.RoomTypeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.IsActive" class="control-label"></label>
                <input asp-for="Room.IsActive" class="form-check-input" />
                <span asp-validation-for="Room.IsActive" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.RoomType" class="control-label"></label>
                <input asp-for="Room.RoomType" class="form-control" />
                <span asp-validation-for="Room.RoomType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Room.Bookings" class="control-label"></label>
                <input asp-for="Room.Bookings" class="form-control" />
                <span asp-validation-for="Room.Bookings" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
