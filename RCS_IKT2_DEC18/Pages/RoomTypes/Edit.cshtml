@page
@model RCS_IKT2_DEC18.Pages.RoomTypePages.EditModel

@{
    ViewData["Title"] = "Szobatípus szerkesztése";
}

<h1>Szerkesztés</h1>

<h4>Szobatípus</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="RoomType.Id" />
            <div class="form-group">
                <label asp-for="RoomType.Name" class="control-label"></label>
                <input asp-for="RoomType.Name" class="form-control" />
                <span asp-validation-for="RoomType.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomType.Capacity" class="control-label"></label>
                <input asp-for="RoomType.Capacity" class="form-control" />
                <span asp-validation-for="RoomType.Capacity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomType.PricePerNight" class="control-label"></label>
                <input asp-for="RoomType.PricePerNight" class="form-control" />
                <span asp-validation-for="RoomType.PricePerNight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="RoomType.Description" class="control-label"></label>
                <input asp-for="RoomType.Description" class="form-control" />
                <span asp-validation-for="RoomType.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
