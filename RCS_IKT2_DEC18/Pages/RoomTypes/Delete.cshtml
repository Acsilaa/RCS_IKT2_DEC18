@page
@model RCS_IKT2_DEC18.Pages.RoomTypePages.DeleteModel

@{
    ViewData["Title"] = "Szobatípus törlése";
}

<h1>Törlés</h1>

<h3>Biztosan törölni szeretné ezt a szobatípust?</h3>
<div>
    <h4>@Model.RoomType.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RoomType.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RoomType.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.RoomType.RoomCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RoomType.RoomCount)
        </dd>
    </dl>
    @if (Model.RoomType.RoomCount > 0)
    {
        <p style="color:red">
            Figyelem! Szobatípust csak akkor lehet törölni, ha nincs hozzárendelt szoba!
        </p>
    }
    
    <form method="post">
        <input type="hidden" asp-for="RoomType.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger" disabled="@(Model.RoomType.RoomCount > 0 ? true : false)" /> |
        <a asp-page="./Index">Vissza a listához</a>
    </form>
</div>
