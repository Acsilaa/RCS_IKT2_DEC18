@page
@model RCS_IKT2_DEC18.Pages.GuestPages.DeleteModel

@{
    ViewData["Title"] = "Vendég törlése";
}

<h1>Törlés</h1>

<h3>Biztosan törölni szeretné?</h3>
<div>
    <h4>Vendég</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.BookingCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.BookingCount)
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Guest.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-page="./Index">Vissza a listához</a>
    </form>
</div>
