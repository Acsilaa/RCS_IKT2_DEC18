@page
@model RCS_IKT2_DEC18.Pages.GuestPages.DetailsModel

@{
    ViewData["Title"] = "Vendég részletek";
}

<h1>Részletek</h1>

<div>
    <h4>Vendég</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.Email)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.Email)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.Phone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.Phone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.RegisteredAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.RegisteredAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Guest.BookingCount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Guest.BookingCount)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Guest.Id">Szerkesztés</a> |
    <a asp-page="./Index">Vissza a listához</a>
</div>
