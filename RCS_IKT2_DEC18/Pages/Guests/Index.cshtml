@page
@model RCS_IKT2_DEC18.Pages.GuestPages.IndexModel

@{
    ViewData["Title"] = "Vendégek";
}

<h1>Vendégek</h1>

<p>
    <a asp-page="Create">+ Új</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Guest[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Guest[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Guest[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Guest[0].RegisteredAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Guest[0].BookingCount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Guest) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(model => item.RegisteredAt)
            </td>
            <td>
                @Html.DisplayFor(model => item.BookingCount)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerk</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Több</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
