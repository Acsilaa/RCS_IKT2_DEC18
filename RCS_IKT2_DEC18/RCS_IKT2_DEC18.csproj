    <UserSecretsId>d3a4977a-95d1-4e33-804c-c26eb3e86d6e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
